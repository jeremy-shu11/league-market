LEAGUE_MARKET_ENV=production
LEAGUE_MARKET_HOST=0.0.0.0
LEAGUE_MARKET_PORT=5065
LEAGUE_MARKET_DB=/data/market.sqlite
LEAGUE_MARKET_RAW_DATA=/data/raw
LEAGUE_MARKET_BACKUP_DIR=/data/backups
LEAGUE_MARKET_SIMULATIONS=20000
LEAGUE_MARKET_SCHEDULE_PIPELINE=0
LEAGUE_MARKET_LEAGUE_ID=1326428061876371456
LEAGUE_MARKET_INVITE_CODE=replace-with-12-plus-random-characters
LEAGUE_MARKET_ADMIN_CODE=replace-with-16-plus-random-characters
LEAGUE_MARKET_ALLOWED_HOSTS=market.example.com
LEAGUE_MARKET_ALLOWED_ORIGINS=https://market.example.com

# Vercel/Turso deployment
# Use these instead of LEAGUE_MARKET_DB when deploying to a serverless host.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token
LEAGUE_MARKET_DATA_DIR=/tmp/league-market
